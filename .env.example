# --- Database -------------------------------------------------------------
# Production (Vercel): a Neon/Supabase Postgres connection string.
# Local development: leave unset and Preflight uses a file-backed PGlite
# database in ./data (no Postgres install required).
DATABASE_URL=

# --- AI review adapter (optional) -----------------------------------------
# Any OpenAI-compatible endpoint (chat completions, structured JSON output).
# Preflight runs its deterministic rule engine with or without a key; the
# in-product disclosure always reports which engine produced the findings.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Hard daily spend cap in USD enforced by the adapter (default 2.00)
AI_SPEND_CAP_USD=2.00

# --- Workspace ------------------------------------------------------------
# Demo personas are used instead of sign-in during Round 2 (see README).
NEXT_PUBLIC_APP_NAME=Preflight
